# Copy to .env.local (never committed) for `npm run dev` and `npm run docker:up`.

# --- Server (runtime; in Coolify: plain environment variables, NOT build variables) ---
# Trusted authentication secret key: ThoughtSpot > Develop > Customizations > Security Settings.
THOUGHTSPOT_SECRET_KEY=
# Org to sign users in to. 0 is the Primary org.
THOUGHTSPOT_ORG_ID=0
# Optional: the ThoughtSpot user the "Register" (store code + PIN) sign-in uses.
THOUGHTSPOT_REGISTER_USERNAME=
# Optional: server-side cluster URL; defaults to VITE_TS_HOST.
# THOUGHTSPOT_HOST=https://thoughtspotpmm.thoughtspot.cloud

# --- Client (build time; in Coolify: tick "Build Variable?") ---
# Optional: these default to the values in src/thoughtspot.ts.
VITE_TS_HOST=https://thoughtspotpmm.thoughtspot.cloud
VITE_INSIGHTS_LIVEBOARD_ID=1a387932-6c25-4e3d-a61a-62803d40ed71
VITE_REGION_LIVEBOARD_ID=0fc762ea-2a1e-4368-927c-a3caf6ed9d23
